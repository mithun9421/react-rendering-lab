# ── Site ──────────────────────────────────────────────────────────────────
# Used by the sitemap, robots.txt, and OpenGraph URLs. Set to your real URL
# in production (e.g. https://react-rendering-lab.com).
NEXT_PUBLIC_SITE_URL=https://react-rendering-lab.vercel.app

# ── Google AdSense (optional) ─────────────────────────────────────────────
# Get these from https://www.google.com/adsense after your site is approved.
# Without them, every <AdSlot/> renders nothing — the lab works fine.

# Publisher ID — looks like "ca-pub-1234567890123456"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Site-ownership meta value, requested by AdSense during the application step.
# Often the same as the publisher ID. Without it, AdSense's "Add the meta tag
# to your site" step doesn't pass.
NEXT_PUBLIC_ADSENSE_VERIFICATION_TAG=

# Per-slot IDs from your AdSense dashboard. Each unique placement gets a
# different slot ID; reusing one across placements muddies AdSense's
# performance reporting.

# Landing-page in-feed (fluid native)
NEXT_PUBLIC_ADSENSE_SLOT_LANDING_INFEED=

# Lab sidebar (vertical / responsive)
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_VERTICAL=

# In-article inside <Lesson> between step 4 and 5
NEXT_PUBLIC_ADSENSE_SLOT_MODULE_INARTICLE=

# End-of-lesson native (in-article)
NEXT_PUBLIC_ADSENSE_SLOT_MODULE_END=

# ── Polar.sh (Pro tier — Phase 2) ─────────────────────────────────────────
# Polar is the Merchant of Record handling Pro tier payments + VAT.
# Without these, /pricing shows "Coming soon" and Pro entitlement is
# never granted to anyone. See MONETISATION.md for the full Phase 2 plan.

# Pre-configured checkout URLs from your Polar dashboard. These are direct
# hosted-checkout URLs you create per product.
NEXT_PUBLIC_POLAR_CHECKOUT_LIFETIME=
NEXT_PUBLIC_POLAR_CHECKOUT_MONTHLY=

# Server-only — webhook signing secret + access token for entitlement
# management. NEVER prefix these with NEXT_PUBLIC_.
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=

# ── Clerk (auth — Phase 2) ────────────────────────────────────────────────
# Wraps the app with <ClerkProvider/>. Free for ≤10k MAU.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (entitlement DB — Phase 2) ───────────────────────────────────
# Source of truth for the `entitlements` table. Free tier covers indie usage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Entitlement JWT (Phase 2) ─────────────────────────────────────────────
# Used to sign the rrl_ent cookie. Generate with: openssl rand -base64 32
ENTITLEMENT_JWT_SECRET=
